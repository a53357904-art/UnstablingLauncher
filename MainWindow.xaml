<Window x:Class="UnstablingLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UnstablingLauncher"
        Height="760"
        Width="1200"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D14"
        Foreground="White">

    <Window.Resources>

        <SolidColorBrush x:Key="PanelColor" Color="#171722"/>
        <SolidColorBrush x:Key="PurpleColor" Color="#9565F5"/>
        <SolidColorBrush x:Key="MutedColor" Color="#9999AA"/>

        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#B9B9C9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#29243C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#191923"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SOL MENÜ -->
        <Border Grid.Column="0"
                Background="#15151F"
                Padding="20">

            <DockPanel>

                <StackPanel DockPanel.Dock="Top">

                    <TextBlock Text="UNSTABLING"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="LAUNCHER"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#A78BFA"
                               Margin="2,2,0,35"/>

                    <TextBlock Text="MENÜ"
                               Foreground="#777789"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="8,0,0,10"/>

                    <Button Style="{StaticResource MenuButton}"
                            Background="#29243C"
                            Foreground="#B99AFF"
                            Content="⌂   Ana Sayfa"/>

                    <Button Style="{StaticResource MenuButton}"
                            Content="▦   Sürümler"/>

                    <Button Style="{StaticResource MenuButton}"
                            Content="▧   Modlar"/>

                    <Button Style="{StaticResource MenuButton}"
                            Content="▤   Kaynak Paketleri"/>

                    <Button Style="{StaticResource MenuButton}"
                            Content="⚙   Ayarlar"/>

                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">

                    <Border Background="#252039"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,0,0,15">

                        <StackPanel>
                            <TextBlock Text="UNSTABLING"
                                       Foreground="#A78BFA"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Minecraft Launcher"
                                       Foreground="#AAAAAA"
                                       FontSize="11"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                    </Border>

                    <TextBlock Text="Version 1.0.0"
                               Foreground="#666677"
                               FontSize="11"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ANA İÇERİK -->
        <Grid Grid.Column="1" Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ÜST BAR -->
            <Grid Grid.Row="0">
                <TextBlock Text="Ana Sayfa"
                           FontSize="25"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Border Background="#201D2D"
                        CornerRadius="20"
                        Padding="15,8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●"
                                   Foreground="#A78BFA"
                                   Margin="0,0,8,0"/>

                        <TextBlock Text="Oyuncu Profili"
                                   Foreground="White"
                                   FontSize="12"/>
                    </StackPanel>

                </Border>
            </Grid>

            <!-- SAYFA -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="0,15,5,0">

                    <!-- HOŞ GELDİN -->
                    <Border Background="#25203B"
                            CornerRadius="18"
                            Padding="30"
                            Height="260"
                            Margin="0,0,0,22">

                        <Grid>

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="UNSTABLING LAUNCHER"
                                           Foreground="#B99AFF"
                                           FontWeight="Bold"
                                           FontSize="13"/>

                                <TextBlock Text="Oyuna hazır mısın?"
                                           Foreground="White"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Margin="0,12,0,5"/>

                                <TextBlock Text="Minecraft dünyana hoş geldin."
                                           Foreground="#B9B4C9"
                                           FontSize="14"
                                           Margin="0,0,0,22"/>

                                <Button Content="▶   MINECRAFT'I BAŞLAT"
                                        Width="230"
                                        Height="48"
                                        HorizontalAlignment="Left"
                                        Background="#9565F5"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        FontSize="13"
                                        BorderThickness="0"
                                        Cursor="Hand"/>

                            </StackPanel>

                            <TextBlock Text="✦"
                                       FontSize="100"
                                       Foreground="#514078"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,35,0"/>

                        </Grid>
                    </Border>

                    <!-- SÜRÜM -->
                    <Border Style="{StaticResource CardStyle}">

                        <StackPanel>
                            <TextBlock Text="OYUN AYARLARI"
                                       Foreground="#A78BFA"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Minecraft Sürümü"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,8,0,12"/>

                            <ComboBox SelectedIndex="0"
                                      Height="38"
                                      Background="#252532"
                                      Foreground="White"
                                      BorderBrush="#39394B"
                                      Padding="8">

                                <ComboBoxItem Content="1.21.4"
                                              Foreground="Black"/>

                                <ComboBoxItem Content="1.21.1"
                                              Foreground="Black"/>

                                <ComboBoxItem Content="1.20.1"
                                              Foreground="Black"/>

                                <ComboBoxItem Content="1.19.4"
                                              Foreground="Black"/>

                            </ComboBox>

                            <TextBlock Text="Sürüm seçimi şu an görsel amaçlıdır."
                                       Foreground="#777789"
                                       FontSize="11"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                    </Border>

                    <!-- HABERLER -->
                    <TextBlock Text="Keşfet"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,8,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource CardStyle}"
                                Margin="0,0,8,15">

                            <StackPanel>
                                <TextBlock Text="🧩 MODLAR"
                                           Foreground="#B99AFF"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Oyununu kişiselleştir."
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Margin="0,10,0,5"/>

                                <TextBlock Text="Mod yönetimi yakında burada."
                                           Foreground="#9999AA"
                                           FontSize="12"/>
                            </StackPanel>

                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource CardStyle}"
                                Margin="8,0,0,15">

                            <StackPanel>
                                <TextBlock Text="🎨 KAYNAK PAKETLERİ"
                                           Foreground="#B99AFF"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Dünyanı değiştir."
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Margin="0,10,0,5"/>

                                <TextBlock Text="Paket yönetimi yakında burada."
                                           Foreground="#9999AA"
                                           FontSize="12"/>
                            </StackPanel>

                        </Border>

                    </Grid>

                    <Border Style="{StaticResource CardStyle}">

                        <StackPanel>
                            <TextBlock Text="UNSTABLING LAUNCHER"
                                       Foreground="#A78BFA"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Minecraft maceran burada başlıyor."
                                       Foreground="#9999AA"
                                       Margin="0,8,0,0"
                                       FontSize="12"/>
                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>
</Window>
